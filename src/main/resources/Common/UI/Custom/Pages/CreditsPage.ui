$C = "../Common.ui";

$C.@PageOverlay {}

$C.@Container {
  Anchor: (Width: 1000, Height: 700);

  #Title {
    Group {
      $C.@Title {
        @Text = "Server Plugins";
      }
    }
  }

  #Content {
    LayoutMode: Top;

    Group #PluginContainer {
      LayoutMode: Left;
      Anchor: (Height: 585);

      Group #PluginList {
        Anchor: (Width: 350);
        LayoutMode: TopScrolling;
        ScrollbarStyle: $C.@DefaultScrollbarStyle;
      }

      Group #PluginInfo {
        FlexWeight: 1;
        LayoutMode: TopScrolling;
        Padding: (Left: 10);
        ScrollbarStyle: $C.@DefaultScrollbarStyle;

        Label #PluginName {
          Style: (
            FontSize: 22,
            RenderUppercase: true,
            RenderBold: true
          );
          Anchor: (Bottom: 3);
        }

        Label #PluginVersion {
          Style: (
            FontSize: 15,
            TextColor: #919191
          );
          Anchor: (Bottom: 12);
        }

        Label #PluginDescription {
          Anchor: (Bottom: 10);
          Style: (Wrap: true);
        }

        Label #PluginLicense {
          Visible: false;
          Anchor: (Bottom: 10);
          Style: (
            Wrap: true,
            TextColor: #c9c9c9
          );
        }

        Group #Authors {
          Anchor: (Width: 600);
          LayoutMode: TopScrolling;
          ScrollbarStyle: $C.@DefaultScrollbarStyle;
        }
      }
    }

    Group #SearchOptions {
      Anchor: (Top: 10);
      LayoutMode: Right;
    }
  }
}

$C.@BackButton {}