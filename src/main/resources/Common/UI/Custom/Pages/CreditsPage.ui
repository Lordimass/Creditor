$C = "../Common.ui";

$C.@PageOverlay {}

$C.@Container {
  Anchor: (Width: 1000, Height: 700);

  #Title {
    Group {
      $C.@Title {
        @Text = "Server Plugins";
      }
    }
  }

  #Content {
    LayoutMode: Top;

    Group #PluginContainer {
      LayoutMode: Left;
      Anchor: (Height: 585);

      Group #PluginList {
        Anchor: (Width: 350);
        LayoutMode: TopScrolling;
        ScrollbarStyle: $C.@DefaultScrollbarStyle;
      }

      Group #PluginInfo {
        FlexWeight: 1;
        LayoutMode: TopScrolling;
        Padding: (Left: 10);
        ScrollbarStyle: $C.@DefaultScrollbarStyle;

        Label #PluginName {
          Style: (
            FontSize: 22,
            RenderUppercase: true,
            RenderBold: true
          );
          Anchor: (Bottom: 3);
        }

        Label #PluginVersion {
          Style: (
            FontSize: 15,
            TextColor: #919191
          );
          Anchor: (Bottom: 12);
        }

        Label #PluginDescription {
          Anchor: (Bottom: 10);
          Style: (Wrap: true);
        }

        Group #Authors {
          Anchor: (Bottom: 10);
          Group #AuthorsHeader {
            Anchor: (Left: 0, Width: 200);
            Label #Name {
              Anchor: (Left: 0, Width: 200);
              Style: LabelStyle(RenderBold: true);
              Padding: (Full: 5);
              Text: "Name";
              OutlineSize: 1.5;
              OutlineColor: #473e26;
              Background: #212121;
            }
            Label #Email {
              Anchor: (Left: 200, Width: 200);
              Style: LabelStyle(RenderBold: true);
              Padding: (Full: 5);
              Text: "Email";
              OutlineSize: 1.5;
              OutlineColor: #473e26;
              Background: #212121;
            }
            Label #Url {
              Anchor: (Left: 400, Width: 200);
              Style: LabelStyle(RenderBold: true);
              Padding: (Full: 5);
              Text: "Url";
              OutlineSize: 1.5;
              OutlineColor: #473e26;
              Background: #212121;
            }
          }
        }
      }
    }

    Group #SearchOptions {
      Anchor: (Top: 10);
      LayoutMode: Right;
    }
  }
}

$C.@BackButton {}