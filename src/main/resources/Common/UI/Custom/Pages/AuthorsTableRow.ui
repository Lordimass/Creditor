$C = "../Common.ui";

Group {
    Anchor: (Left: 5, Width: 600);
    FlexWeight: 1;
    LayoutMode: Left;

    Label #Name {
      Anchor: (Width: 200);
      Padding: (Full: 5);
      OutlineSize: 1.5;
      OutlineColor: #473e26;
      Background: #1b263a;
      TextTooltipStyle: $C.@DefaultTextTooltipStyle;
    }
    Label #Email {
      Anchor: (Width: 200);
      Padding: (Full: 5);
      OutlineSize: 1.5;
      OutlineColor: #473e26;
      Background: #1b263a;
      TextTooltipStyle: $C.@DefaultTextTooltipStyle;
    }
    Label #Url {
      Anchor: (Width: 200);
      Padding: (Full: 5);
      OutlineSize: 1.5;
      OutlineColor: #473e26;
      Background: #1b263a;
      TextTooltipStyle: $C.@DefaultTextTooltipStyle;
    }
}